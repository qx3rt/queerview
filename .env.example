# TMDB read access token (bearer token), NOT the v3 API key.
# Get one at https://www.themoviedb.org/settings/api after creating a free account.
# This is safe to expose client-side under TMDB's non-commercial terms, but keep it
# to a read-only token — never a write-capable credential.
PUBLIC_TMDB_TOKEN=

# Anthropic API key for the internal AI pre-tagging tool (scripts/pretag.mjs).
# Get one at https://console.anthropic.com/settings/keys.
# Maintainer-only — never expose this client-side, unlike PUBLIC_TMDB_TOKEN above.
ANTHROPIC_API_KEY=
