---
interface Props {
  level: 1 | 2 | 3 | 4 | 5;
}
const { level } = Astro.props;
const labels: Record<number, string> = {
  1: 'No romantic or sexual content',
  2: 'Kissing, mild romance',
  3: 'Implied sexual content, fade to black',
  4: 'Moderate explicit content',
  5: 'Explicit sexual content',
};
---

<span class="spicy-level" title={labels[level]} aria-label={`Spicy level ${level} of 5: ${labels[level]}`}>
  {Array.from({ length: 5 }).map((_, i) => (
    <span class:list={['flame', { lit: i < level }]}>🔥</span>
  ))}
</span>

<style>
  .spicy-level {
    display: inline-flex;
    gap: 0.1rem;
  }

  .flame {
    font-size: 0.85rem;
    filter: grayscale(1);
    opacity: 0.35;
  }

  .flame.lit {
    filter: none;
    opacity: 1;
  }
</style>
