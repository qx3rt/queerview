---
import Layout from '../layouts/Layout.astro';
import { getAllTagVocabs } from '../lib/data';

const vocabs = getAllTagVocabs();
const sectionTitles: Record<string, string> = {
  identities: 'Identities',
  rep_quality: 'Rep quality',
  rep_tropes: 'Tropes',
  trigger_warnings: 'Trigger warnings',
  community_tags: 'Community tags',
  genres: 'Genres',
  creator_roles: 'Creator roles',
  source_types: 'Source types',
};
---

<Layout title="Tags" description="The full Queerview tagging vocabulary.">
  <h1>Tag vocabulary</h1>
  <p class="intro">
    Every tag applied to a title on Queerview comes from this shared vocabulary. Identity labels
    are never up for debate — contributors may propose additions, but existing labels are not
    removed because someone disagrees they're valid.
  </p>

  {Object.entries(vocabs).map(([key, tags]) => (
    <section>
      <h2>{sectionTitles[key] ?? key}</h2>
      <dl>
        {tags.map((t) => (
          <>
            <dt>{t.label}</dt>
            <dd>{t.description}</dd>
          </>
        ))}
      </dl>
    </section>
  ))}
</Layout>

<style>
  .intro {
    max-width: 40rem;
    color: var(--text-muted);
    margin-bottom: 2rem;
  }

  section {
    margin-bottom: 2.5rem;
  }

  section h2 {
    font-size: 1.15rem;
    margin-bottom: 0.75rem;
    border-bottom: 1px solid var(--border);
    padding-bottom: 0.4rem;
  }

  dl {
    display: grid;
    grid-template-columns: 12rem 1fr;
    row-gap: 0.6rem;
    column-gap: 1rem;
    margin: 0;
  }

  dt {
    font-weight: 700;
    color: var(--accent-pink);
  }

  dd {
    margin: 0;
    color: var(--text-muted);
  }

  @media (max-width: 36rem) {
    dl {
      grid-template-columns: 1fr;
    }
    dt {
      margin-top: 0.5rem;
    }
  }
</style>
